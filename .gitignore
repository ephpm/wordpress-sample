# WordPress core is fetched by assemble.sh, never committed.
/wp-admin/
/wp-includes/
/wp-*.php
!/wp-config.php
/index.php
/xmlrpc.php
/license.txt
/readme.html
/wp-content/plugins/
/wp-content/themes/
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/languages/

# Written into the deployed docroot by the seed steps, never committed.
# (Both are dot-prefixed so ePHPm answers 403 for them — the docroot is the
# repository root, so anything NOT dot-prefixed here is publicly served.)
/.seed.log
/.wp-admin-credentials

# Per-site databases and assembled docroots.
*.db
*.db-wal
*.db-shm
